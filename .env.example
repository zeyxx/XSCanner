# XSCanner has offline unit tests and explicit CLI scripts, not a deployed server.
# No env values are needed for offline tests. Live provider/partner access requires
# a separately approved scope, budget and currently valid credentials.
# Never reuse an exposed or unconfirmed partner key. Local .env is ignored by Git.
X_API_BEARER_TOKEN=
MODEL_ALERT_KEY=
GETXAPI_KEY=
