{
  "name": "xscanner",
  "version": "0.1.0",
  "description": "Transparent, authenticity-adjusted, contract-address-keyed, minute-resolution attention measure for fresh Solana memecoins",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "check:cli": "tsc -p tsconfig.cli.json",
    "test": "vitest run",
    "collect": "node --env-file=.env --import tsx scripts/collect-alerts.ts",
    "summary": "node --import tsx scripts/summarize-alerts.ts",
    "prices": "node --import tsx scripts/track-prices.ts",
    "analyze": "node --import tsx scripts/analyze-prices.ts",
    "probe:getxapi": "node --env-file=.env --import tsx scripts/probe-getxapi.ts",
    "compare:x": "node --import tsx scripts/compare-x.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "5.1.1"
  }
}
